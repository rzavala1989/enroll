# Every variable here is validated at boot by src/config/env.ts. A
# missing or malformed value aborts startup with a message naming it,
# rather than surfacing as a 500 on the first request that needs it.

# ── Required ────────────────────────────────────────────────────────

DATABASE_URL="postgresql://enroll:enroll@localhost:5442/enroll"

# Signs access JWTs. At least 32 characters; generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="change-me"

# Waitlist promotion queue (BullMQ). The API will not boot without it.
# `rediss://` switches the client to TLS for a managed provider.
REDIS_URL="redis://localhost:6389"

# ── Optional, with defaults ─────────────────────────────────────────

NODE_ENV="development"
PORT=3000

JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Comma-separated browser origins allowed to send credentialed
# requests. Required in production; the default covers local dev.
CORS_ORIGINS="http://localhost:3001"

# Reverse proxies in front of this process. Express reads
# X-Forwarded-For to this depth to compute req.ip, which is what the
# audit trail records as the actor's address. Behind the Next.js
# rewrite this is 1; add one per additional load balancer. Left at 0,
# every audit row records the proxy rather than the student.
TRUST_PROXY_HOPS=0

# Audit log destination. Optional: without it, audit rows accumulate in
# the Postgres outbox and the drain reports itself as not configured
# rather than failing.
MONGODB_URI="mongodb://localhost:27027"
MONGODB_DB="enroll_audit"

# Whether this process runs the timer-driven work: the audit outbox
# drain, the hourly waitlist expiry, and the promotion safety-net sweep.
# None of them are leader-elected, so run exactly ONE deployment with
# this true. With two, the outbox is double-drained and every expired
# waitlist student gets duplicate notifications.
SCHEDULERS_ENABLED=true

# TTL for cached catalog pages. Short because those rows carry live seat
# counts and students refresh them during registration.
CATALOG_CACHE_TTL_MS=15000

LOG_LEVEL="info"

# ── Removed ─────────────────────────────────────────────────────────
#
# JWT_REFRESH_SECRET is gone. Refresh tokens are opaque 32-byte random
# strings stored as SHA-256 hashes, never JWTs, so no code ever read
# that variable. It stayed in this file long enough that operators were
# rotating a secret that did nothing.
