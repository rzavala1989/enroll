{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@enroll/shared$": "<rootDir>/../../packages/shared/dist"
  },
  "testEnvironment": "node",
  "testTimeout": 180000,
  "maxWorkers": 1
}
